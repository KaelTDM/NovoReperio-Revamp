---
import SiteLayout from "../layouts/SiteLayout.astro";
import FeaturedProject from "../components/FeaturedProject.astro";
import FilterTabs from "../components/FilterTabs.astro";
import ProjectCard from "../components/ProjectCard.astro";
import projects from "../data/work-projects.json";

const filters = [
  "All",
  "Matterport 3D Tours",
  "360° Virtual Tours",
  "Drone & Aerial",
  "Hospitality",
  "Corporate",
  "Retail",
];

const featuredProject = projects.find((project) => project.featured) ?? projects[0];
const gridProjects = projects.filter((project) => project.id !== featuredProject.id);
const trustedBrands = ["Hyatt Regency", "Maxis", "Compass Offices", "World Trade Centre Kuala Lumpur", "Space Furniture"];
const filterCounts = Object.fromEntries(
  filters.map((filter) => [
    filter,
    gridProjects.filter((project) => filter === "All" || project.filterGroup === filter || project.industry === filter).length,
  ]),
);
const serviceFilters = [...new Set(gridProjects.map((project) => project.filterGroup))];
const spaceFilters = [...new Set(gridProjects.map((project) => project.spaceType ?? project.industry))];
const serviceAllLabel = "All Services";
const spaceAllLabel = "All Spaces";
const serviceCounts = Object.fromEntries([
  [serviceAllLabel, gridProjects.length],
  ...serviceFilters.map((filter) => [
    filter,
    gridProjects.filter((project) => project.filterGroup === filter).length,
  ]),
]);
const spaceCounts = Object.fromEntries([
  [spaceAllLabel, gridProjects.length],
  ...spaceFilters.map((filter) => [
    filter,
    gridProjects.filter((project) => (project.spaceType ?? project.industry) === filter).length,
  ]),
]);
---

<SiteLayout
  title="Novo Reperio Works | Premium Virtual Tour Portfolio"
  description="Explore Novo Reperio project work across Matterport 3D tours, 360 virtual tours, and drone aerial presentations for hospitality, corporate, and retail spaces."
>
  <style is:global>
    :root {
      --nr-blue: #159fe6;
      --nr-blue-dark: #0f83bf;
      --nr-pink: #e4126a;
      --nr-orange: #f37121;
      --works-ink: #101114;
      --works-line: rgba(16, 17, 20, 0.1);
      --works-shadow: 0 12px 30px rgba(16, 17, 20, 0.08);
      --works-shadow-strong: 0 24px 52px rgba(7, 12, 20, 0.18);
    }

    .works-container {
      width: 100%;
      max-width: 1680px;
      margin: 0 auto;
      padding-inline: 100px;
    }

    .site-header {
      position: sticky;
      top: 0;
      z-index: 70;
      background: rgba(12, 12, 15, 0.82);
      border-bottom: 1px solid rgba(255, 255, 255, 0.08);
      backdrop-filter: blur(20px);
    }

    .works-nav {
      display: flex;
      min-height: 72px;
      align-items: center;
      justify-content: space-between;
      gap: 24px;
      color: #fff;
    }

    .works-brand {
      display: inline-flex;
      align-items: center;
    }

    .works-brand-mark {
      width: 192px;
      height: 40px;
      object-fit: contain;
      object-position: center;
    }

    .works-nav-links,
    .works-nav-actions {
      display: flex;
      align-items: center;
      gap: 24px;
    }

    .works-nav-links a {
      position: relative;
      color: rgba(255, 255, 255, 0.86);
      font-size: 14px;
      font-weight: 700;
      transition: color .22s ease;
    }

    .works-nav-links a::after {
      content: "";
      position: absolute;
      left: 0;
      right: 0;
      bottom: -10px;
      height: 2px;
      border-radius: 999px;
      background: linear-gradient(90deg, rgba(21,159,230,.25), #159fe6 40%, rgba(21,159,230,.25));
      transform: scaleX(.28);
      transform-origin: center;
      opacity: 0;
      transition: transform .26s ease, opacity .26s ease;
      box-shadow: 0 0 14px rgba(21,159,230,.28);
    }

    .works-nav-links a:hover,
    .works-nav-links a.is-active {
      color: #fff;
    }

    .works-nav-links a:hover::after,
    .works-nav-links a.is-active::after {
      transform: scaleX(1);
      opacity: 1;
    }

    .works-nav-btn {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      min-height: 48px;
      padding: 0 22px;
      border-radius: 10px;
      border: 1px solid transparent;
      font-size: 14px;
      font-weight: 800;
      transition: transform .2s ease, box-shadow .2s ease, border-color .2s ease, background .2s ease, color .2s ease;
    }

    .works-nav-btn:hover {
      transform: translateY(-2px);
      box-shadow: 0 12px 24px rgba(21,159,230,.18);
    }

    .works-nav-btn-primary {
      color: #fff;
      background: var(--nr-blue);
      border-color: var(--nr-blue);
    }

    .works-nav-btn-primary:hover {
      background: var(--nr-blue-dark);
      border-color: var(--nr-blue-dark);
    }

    .works-nav-btn-secondary {
      color: #fff;
      border-color: rgba(255,255,255,.55);
      background: rgba(255,255,255,.06);
      backdrop-filter: blur(14px);
    }

    .works-hero {
      position: relative;
      overflow: hidden;
      color: #fff;
      background:
        radial-gradient(circle at 84% 12%, rgba(21,159,230,.22), transparent 28%),
        linear-gradient(112deg, rgba(6,6,8,.99) 0%, rgba(12,12,15,.96) 42%, rgba(12,18,26,.92) 100%);
    }

    .works-hero::before {
      content: "";
      position: absolute;
      inset: auto -10% -34% -10%;
      height: 60%;
      background:
        radial-gradient(circle, rgba(255,255,255,.13) 0 1px, transparent 1.8px) 0 0 / 22px 22px,
        radial-gradient(circle, rgba(21,159,230,.14) 0 1px, transparent 2px) 11px 11px / 22px 22px;
      opacity: .24;
      transform: perspective(1100px) rotateX(74deg) scale(1.68);
      pointer-events: none;
    }

    .works-empty-state {
      display: none;
    }

    .works-empty-state.is-visible {
      display: block;
    }

    .works-footer {
      color: #fff;
      background:
        radial-gradient(circle at 82% 18%, rgba(21,159,230,.18), transparent 22%),
        linear-gradient(180deg, rgba(8,12,18,.98), rgba(10,12,18,.99));
    }

    @media (max-width: 820px) {
      .works-container {
        padding-inline: 10px;
      }

      .works-nav {
        min-height: 66px;
      }

      .works-nav-links {
        display: none;
      }

      .works-nav-actions .works-secondary {
        display: none;
      }

      .works-brand-mark {
        width: 164px;
        height: 34px;
      }
    }
  </style>

  <header class="site-header">
    <div class="works-container works-nav">
      <a href="/" class="works-brand" aria-label="Novo Reperio home">
        <img class="works-brand-mark" src="/images/Novo-logo-for-website.png.webp" alt="Novo Reperio" loading="eager" />
      </a>
      <nav class="works-nav-links" aria-label="Primary navigation">
        <a href="/">Home</a>
        <a href="/services">Services</a>
        <a class="is-active" href="/works">Works</a>
        <a href="/about">About</a>
        <a href="/contact">Contact</a>
        <a href="/insights">Insights</a>
      </nav>
      <div class="works-nav-actions">
        <a class="works-secondary works-nav-btn works-nav-btn-secondary" href="/services">Explore Services</a>
        <a class="works-nav-btn works-nav-btn-primary" href="/contact">Request Quote</a>
      </div>
    </div>
  </header>

  <main class="bg-[linear-gradient(180deg,#fff,#f8fbff_24%,#fff_100%)] text-zinc-950">
    <section class="works-hero border-b border-white/10">
      <div class="works-container py-20 md:py-24">
        <span class="inline-flex rounded-full bg-[#e4126a] px-3 py-1 text-[10px] font-black uppercase tracking-[0.18em] text-white">
          Portfolio
        </span>
        <div class="mt-6 max-w-4xl">
          <h1 class="max-w-3xl text-[clamp(3.75rem,8vw,7.5rem)] font-semibold leading-[0.88] tracking-[-0.09em] text-white">
            Our Works
          </h1>
          <p class="mt-5 max-w-2xl text-lg leading-8 text-white/80">
            Explore how we help businesses showcase their spaces with immersive virtual experiences.
          </p>
        </div>
        <div class="mt-10 flex flex-wrap gap-3">
          <a class="inline-flex min-h-12 items-center justify-center rounded-[14px] border border-sky-500 bg-sky-500 px-5 text-sm font-black uppercase tracking-[0.14em] text-white shadow-[0_12px_22px_rgba(21,159,230,.24)] transition hover:border-[#0f83bf] hover:bg-[#0f83bf]" href="#featured-project">
            View Featured Project
          </a>
          <a class="inline-flex min-h-12 items-center justify-center rounded-[14px] border border-white/30 bg-white/6 px-5 text-sm font-black uppercase tracking-[0.14em] text-white transition hover:bg-white hover:text-zinc-950" href="/contact">
            Request Quote
          </a>
        </div>
        <div class="mt-10 border-t border-white/10 pt-5">
          <p class="text-[11px] font-black uppercase tracking-[0.18em] text-white/72">
            Trusted by leading brands across Malaysia
          </p>
          <div class="mt-4 flex flex-wrap gap-2">
            {trustedBrands.slice(0, 4).map((brand) => (
              <span class="inline-flex rounded-full border border-white/10 bg-white/5 px-3 py-1.5 text-[10px] font-black uppercase tracking-[0.16em] text-white/88">
                {brand}
              </span>
            ))}
          </div>
        </div>
      </div>
    </section>

    <section class="border-b border-black/8 bg-transparent">
      <div class="works-container py-8 md:py-10">
        <div id="featured-project" class="border-b border-black/8 pb-8 md:pb-10">
          <FeaturedProject project={featuredProject} />
        </div>

        <div class="mt-6 rounded-[10px] border border-black/8 bg-[linear-gradient(180deg,rgba(255,255,255,.98),rgba(246,250,255,.98))] px-4 py-4 text-sm leading-7 text-zinc-700 shadow-[0_12px_30px_rgba(16,17,20,.08)] md:flex md:items-center md:justify-between md:gap-6">
          <p>
            <span class="mr-3 inline-block text-[10px] font-black uppercase tracking-[0.16em] text-zinc-950">Trusted in</span>
            Hospitality, corporate, and retail environments where audiences need to understand the space before arrival.
          </p>
          <div class="mt-3 flex flex-wrap gap-2 md:mt-0">
            {trustedBrands.map((brand) => (
              <span class="rounded-full border border-black/8 bg-white px-2.5 py-1 text-[10px] font-black uppercase tracking-[0.14em] text-zinc-700">
                {brand}
              </span>
            ))}
          </div>
        </div>

        <div class="mt-8 border-b border-black/8 pb-4">
          <div class="max-w-2xl">
            <p class="text-[10px] font-black uppercase tracking-[0.18em] text-zinc-500">Browse by service or sector</p>
            <h2 class="mt-2 text-[clamp(2rem,4vw,3.4rem)] font-semibold leading-[0.96] tracking-[-0.07em] text-zinc-950">
              Selected Projects
            </h2>
            <p class="mt-3 text-sm leading-7 text-zinc-600">
              Each card is a fast preview of what the project helped clients communicate, without turning the page into a wall of text.
            </p>
          </div>
        </div>

        <div class="mt-5 grid gap-4">
          <FilterTabs
            filters={spaceFilters}
            group="space"
            label="Space Type"
            allLabel={spaceAllLabel}
          />
        </div>

        <div class="project-grid mt-6 grid gap-4 md:grid-cols-2 md:gap-4 xl:grid-cols-3 xl:gap-6" data-project-grid>
          {gridProjects.map((project, index) => (
            <ProjectCard project={project} index={index} />
          ))}
        </div>

        <div class="works-empty-state mt-4 rounded-[10px] border border-black/8 bg-[linear-gradient(180deg,rgba(255,255,255,.98),rgba(246,250,255,.98))] px-4 py-4 text-sm leading-7 text-zinc-700 shadow-[0_12px_30px_rgba(16,17,20,.08)]" data-empty-state>
          No projects match this filter yet. Try another category to explore more of Novo Reperio's work.
        </div>

        <section class="mt-10 rounded-[14px] border border-black/8 bg-[linear-gradient(180deg,rgba(255,255,255,.99),rgba(248,250,253,.98))] shadow-[0_12px_30px_rgba(16,17,20,.08)]">
          <div class="grid gap-6 px-5 py-6 md:grid-cols-[minmax(0,0.92fr)_minmax(0,1.08fr)] md:items-center md:px-6">
            <div>
              <span class="inline-flex rounded-full bg-[#e4126a] px-3 py-1 text-[10px] font-black uppercase tracking-[0.16em] text-white">Next Step</span>
              <h2 class="mt-4 text-[clamp(2rem,4vw,3.6rem)] font-semibold leading-[0.96] tracking-[-0.07em] text-zinc-950">
                Ready to showcase your space like this?
              </h2>
              <p class="mt-4 max-w-2xl text-sm leading-7 text-zinc-600">
                Novo Reperio can help you choose the right virtual tour, visual format, and presentation flow for your venue, property, office, showroom, or destination.
              </p>
            </div>
            <div class="flex flex-wrap gap-3 md:justify-end">
              <a class="inline-flex min-h-12 items-center justify-center rounded-[14px] border border-sky-500 bg-sky-500 px-5 text-sm font-black uppercase tracking-[0.14em] text-white shadow-[0_12px_22px_rgba(21,159,230,.24)] transition hover:border-[#0f83bf] hover:bg-[#0f83bf]" href="/contact">
                Request Quote
              </a>
              <a class="inline-flex min-h-12 items-center justify-center rounded-[14px] border border-black/8 bg-white px-5 text-sm font-black uppercase tracking-[0.14em] text-zinc-950 transition hover:bg-zinc-950 hover:text-white" href="/contact">
                Contact Us
              </a>
            </div>
          </div>
        </section>
      </div>
    </section>
  </main>

  <script>
    const filterButtons = Array.from(document.querySelectorAll("[data-filter-button]"));
    const projectCards = Array.from(document.querySelectorAll("[data-project-card]"));
    const emptyState = document.querySelector("[data-empty-state]");
    let activeSpaceFilter = "All Spaces";

    if (filterButtons.length && projectCards.length) {
      const applyFilters = () => {
        let visibleCount = 0;

        filterButtons.forEach((button) => {
          const value = button.dataset.filter;
          const isActive = value === activeSpaceFilter;
          button.classList.toggle("is-active", isActive);
          button.setAttribute("aria-pressed", isActive ? "true" : "false");
        });

        projectCards.forEach((card) => {
          const spaceValue = card.dataset.spaceFilter || "";
          const isVisible = activeSpaceFilter === "All Spaces" || spaceValue === activeSpaceFilter;
          card.classList.toggle("is-hidden", !isVisible);

          if (isVisible) {
            visibleCount += 1;
          }
        });

        if (emptyState) {
          emptyState.classList.toggle("is-visible", visibleCount === 0);
        }
      };

      filterButtons.forEach((button) => {
        button.addEventListener("click", () => {
          const value = button.dataset.filter;
          if (!value) return;
          activeSpaceFilter = value;
          applyFilters();
        });
      });

      applyFilters();
    }
  </script>

  <footer class="works-footer">
    <div class="works-container grid gap-8 py-14 md:grid-cols-[minmax(0,1.2fr)_repeat(4,minmax(0,0.7fr))]">
      <div>
        <h3 class="text-2xl font-semibold leading-none tracking-[-0.05em]">Tell us about your space.</h3>
        <p class="mt-4 max-w-md text-sm leading-7 text-white/72">
          Share the project type, location, and what the digital presentation needs to help your audience understand more clearly.
        </p>
        <form class="mt-5 flex flex-col gap-3 sm:flex-row">
          <input class="min-h-12 w-full rounded-[14px] border border-white/15 bg-white/5 px-4 text-sm text-white placeholder:text-white/40" type="email" placeholder="Your email" aria-label="Email address" />
          <button class="min-h-12 rounded-[14px] border border-sky-500 bg-sky-500 px-5 text-sm font-black uppercase tracking-[0.14em] text-white shadow-[0_12px_22px_rgba(21,159,230,.24)] transition hover:border-[#0f83bf] hover:bg-[#0f83bf]" type="submit">
            Request Quote
          </button>
        </form>
      </div>
      <div>
        <h4 class="text-lg font-semibold tracking-[-0.04em]">Works</h4>
        <a class="mt-2 block text-sm leading-7 text-white/70" href="#featured-project">Featured Project</a>
        <a class="mt-1 block text-sm leading-7 text-white/70" href="#">Matterport 3D Tours</a>
        <a class="mt-1 block text-sm leading-7 text-white/70" href="#">360° Virtual Tours</a>
        <a class="mt-1 block text-sm leading-7 text-white/70" href="#">Drone & Aerial</a>
      </div>
      <div>
        <h4 class="text-lg font-semibold tracking-[-0.04em]">Services</h4>
        <a class="mt-2 block text-sm leading-7 text-white/70" href="/services#matterport">Matterport 3D Virtual Tours</a>
        <a class="mt-1 block text-sm leading-7 text-white/70" href="/services#tours-360">360 Virtual Tours</a>
        <a class="mt-1 block text-sm leading-7 text-white/70" href="/services#drone-aerial">Drone & Aerial</a>
        <a class="mt-1 block text-sm leading-7 text-white/70" href="/services#support-services">Support Services</a>
      </div>
      <div>
        <h4 class="text-lg font-semibold tracking-[-0.04em]">Company</h4>
        <a class="mt-2 block text-sm leading-7 text-white/70" href="/about">About Novo Reperio</a>
        <a class="mt-1 block text-sm leading-7 text-white/70" href="/works">Works</a>
        <a class="mt-1 block text-sm leading-7 text-white/70" href="/insights">Insights</a>
        <a class="mt-1 block text-sm leading-7 text-white/70" href="/contact">Contact</a>
      </div>
      <div>
        <h4 class="text-lg font-semibold tracking-[-0.04em]">Next</h4>
        <a class="mt-2 block text-sm leading-7 text-white/70" href="/contact">Request Quote</a>
        <a class="mt-1 block text-sm leading-7 text-white/70" href="/contact">Contact Us</a>
        <a class="mt-1 block text-sm leading-7 text-white/70" href="/">Back to homepage</a>
      </div>
    </div>
    <div class="works-container flex flex-col gap-5 border-t border-white/10 py-6 md:flex-row md:items-center md:justify-between">
      <a class="works-brand" href="/"><img class="works-brand-mark" src="/images/Novo-logo-for-website.png.webp" alt="Novo Reperio" loading="lazy" /></a>
      <div class="flex flex-wrap gap-4 text-sm text-white/70">
        <a href="#">Privacy Policy</a>
        <a href="#">Terms</a>
        <a href="/contact">Contact</a>
      </div>
      <span class="text-sm text-white/60">Novo Reperio portfolio showcase.</span>
    </div>
  </footer>
</SiteLayout>
