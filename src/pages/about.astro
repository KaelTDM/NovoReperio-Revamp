---

<SiteLayout
  title="About Novo Reperio | Spatial presentation for physical spaces"
  description="Learn how Novo Reperio approaches digital twins, virtual tours, and immersive presentation for venues, property teams, and physical spaces."
>
  <style is:global>
    :root {
      --nr-blue: #159fe6;
      --nr-blue-dark: #0f83bf;
      --nr-pink: #e4126a;
      --nr-orange: #f37121;
      --about-ink: #101114;
      --about-line: rgba(16, 17, 20, 0.1);
      --about-shadow: 0 12px 30px rgba(16, 17, 20, 0.08);
      --about-shadow-strong: 0 24px 52px rgba(7, 12, 20, 0.18);
    }

    .about-container {
      width: 100%;
      max-width: 1680px;
      margin: 0 auto;
      padding-inline: 100px;
    }

    .about-header {
      position: sticky;
      top: 0;
      z-index: 70;
      background: rgba(255,255,255,.84);
      border-bottom: 1px solid rgba(148,163,184,.2);
      backdrop-filter: blur(18px);
    }

    .about-nav {
      display: flex;
      min-height: 76px;
      align-items: center;
      justify-content: space-between;
      gap: 24px;
      color: #070b12;
    }

    .about-brand {
      display: inline-flex;
      align-items: center;
      gap: 12px;
    }

    .about-brand-mark {
      width: 192px;
      height: 40px;
      object-fit: contain;
      object-position: center;
    }

    .about-nav-links,
    .about-nav-actions {
      display: flex;
      align-items: center;
      gap: 24px;
    }

    .about-nav-links a {
      position: relative;
      color: #5f6673;
      font-size: 14px;
      font-weight: 700;
      transition: color 0.22s ease;
    }

    .about-nav-links a::after {
      content: "";
      position: absolute;
      left: 0;
      right: 0;
      bottom: -10px;
      height: 3px;
      border-radius: 999px;
      background: #ec4899;
      transform: scaleX(.36);
      transform-origin: center;
      opacity: 0;
      transition: transform .26s ease, opacity .26s ease;
    }

    .about-nav-links a:hover,
    .about-nav-links a.is-active {
      color: #070b12;
    }

    .about-nav-links a:hover::after,
    .about-nav-links a.is-active::after {
      transform: scaleX(1);
      opacity: 1;
    }

    .about-nav-btn {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      min-height: 46px;
      padding: 0 24px;
      border-radius: 12px;
      border: 1px solid transparent;
      font-size: 14px;
      font-weight: 800;
      transition: transform .2s ease, box-shadow .2s ease, border-color .2s ease, background .2s ease, color .2s ease;
    }

    .about-nav-btn:hover {
      transform: translateY(-2px);
      box-shadow: 0 12px 24px rgba(21,159,230,.18);
    }

    .about-nav-btn-primary {
      color: #fff;
      background: #1d4ed8;
      border-color: #1d4ed8;
      box-shadow: 0 16px 40px rgba(29,78,216,.18);
    }

    .about-nav-btn-primary:hover {
      background: #1e40af;
      border-color: #1e40af;
    }

    .about-nav-btn-secondary {
      color: #070b12;
      border-color: rgba(15,23,42,.22);
      background: rgba(255,255,255,.9);
    }

    .about-hero {
      position: relative;
      overflow: hidden;
      color: #070b12;
      background: #f7f8fa;
      border-bottom: 1px solid rgba(148,163,184,.16);
    }

    .about-hero::before {
      content: "";
      position: absolute;
      inset: 0;
      background:
        radial-gradient(circle at 14% 18%, rgba(255,255,255,.9), transparent 28%),
        radial-gradient(circle at 82% 18%, rgba(255,255,255,.72), transparent 22%);
      pointer-events: none;
    }

    .about-hero::after {
      content: "";
      position: absolute;
      inset: 28% -8% auto auto;
      width: 320px;
      height: 320px;
      background:
        radial-gradient(circle, rgba(236,72,153,.22) 1px, transparent 1px) 0 0 / 14px 14px;
      opacity: .14;
      pointer-events: none;
    }

    .about-hero-grid {
      position: relative;
      z-index: 1;
      display: grid;
      grid-template-columns: minmax(0, 0.85fr) minmax(0, 1.15fr);
      gap: 28px 44px;
      padding: 56px 0 36px;
      align-items: center;
    }

    .about-hero-kicker {
      display: inline-flex;
      align-items: center;
      gap: 14px;
      color: #ec4899;
      font-size: 11px;
      font-weight: 900;
      letter-spacing: .22em;
      text-transform: uppercase;
    }

    .about-hero-kicker span:last-child {
      width: 64px;
      height: 1px;
      background: currentColor;
    }

    .about-hero-copy h1 {
      max-width: 9ch;
      margin-top: 18px;
      font-size: clamp(3.5rem, 6.2vw, 6.7rem);
      font-weight: 600;
      line-height: .86;
      letter-spacing: -0.085em;
      color: #070b12;
    }

    .about-hero-copy p {
      max-width: 34rem;
      margin-top: 24px;
      color: #5f6673;
      font-size: 18px;
      line-height: 1.84;
    }

    .about-hero-actions {
      display: flex;
      flex-wrap: wrap;
      gap: 14px;
      margin-top: 28px;
    }

    .about-hero-chip-grid {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 10px;
      max-width: 34rem;
      margin-top: 24px;
    }

    .about-hero-chip {
      display: flex;
      align-items: center;
      gap: 12px;
      border-radius: 12px;
      border: 1px solid rgba(148,163,184,.22);
      background: #fff;
      padding: 12px 14px;
      color: #475467;
      font-size: 13px;
      font-weight: 800;
      box-shadow: 0 10px 22px rgba(15,23,42,.04);
    }

    .about-hero-chip-icon {
      display: inline-flex;
      width: 28px;
      height: 28px;
      flex: 0 0 28px;
      align-items: center;
      justify-content: center;
      border-radius: 10px;
      background: #eff6ff;
      color: #1d4ed8;
      font-size: 12px;
      font-weight: 900;
    }

    .about-hero-note {
      margin-top: 18px;
      max-width: 30rem;
      color: #64748b;
      font-size: 14px;
      line-height: 1.72;
    }

    .about-hero-note strong {
      color: #ec4899;
      margin-right: 8px;
    }

    .about-hero-visual {
      position: relative;
      min-height: 650px;
    }

    .about-hero-dot-pattern {
      position: absolute;
      top: 268px;
      right: 24px;
      width: 170px;
      height: 170px;
      background: radial-gradient(circle, #ec4899 1px, transparent 1px) 0 0 / 14px 14px;
      opacity: .2;
    }

    .about-hero-card {
      position: absolute;
      overflow: hidden;
      border-radius: 28px;
      background: #d7dde6;
      box-shadow: 0 26px 74px rgba(15,23,42,.14);
    }

    .about-hero-card img {
      width: 100%;
      height: 100%;
      display: block;
      object-fit: cover;
    }

    .about-hero-card-main {
      top: 0;
      left: 0;
      width: 68%;
      height: 360px;
    }

    .about-hero-card-aerial {
      top: 10px;
      right: 0;
      width: 37%;
      height: 220px;
    }

    .about-hero-studio-card {
      position: absolute;
      top: 164px;
      right: 11%;
      z-index: 3;
      width: 350px;
      border-radius: 28px;
      border: 1px solid rgba(148,163,184,.2);
      background: rgba(255,255,255,.96);
      padding: 26px;
      box-shadow: 0 30px 90px rgba(15,23,42,.16);
      backdrop-filter: blur(18px);
    }

    .about-panel-label {
      display: inline-flex;
      border-radius: 999px;
      background: #fdf2f8;
      color: #ec4899;
      padding: 6px 10px;
      font-size: 10px;
      font-weight: 900;
      letter-spacing: .18em;
      text-transform: uppercase;
    }

    .about-hero-studio-card h2 {
      margin-top: 18px;
      font-size: 32px;
      line-height: 1.04;
      letter-spacing: -0.055em;
      color: #070b12;
    }

    .about-panel-list {
      display: grid;
      gap: 18px;
      margin-top: 26px;
    }

    .about-panel-item {
      display: grid;
      grid-template-columns: 36px minmax(0, 1fr);
      gap: 14px;
      padding-bottom: 18px;
      border-bottom: 1px solid rgba(148,163,184,.22);
    }

    .about-panel-item:last-child {
      border-bottom: 0;
      padding-bottom: 0;
    }

    .about-panel-icon {
      display: inline-flex;
      width: 36px;
      height: 36px;
      align-items: center;
      justify-content: center;
      border-radius: 50%;
      border: 1px solid rgba(148,163,184,.34);
      color: #334155;
      font-size: 16px;
      font-weight: 900;
    }

    .about-panel-item strong {
      display: block;
      color: #94a3b8;
      font-size: 10px;
      font-weight: 900;
      letter-spacing: .18em;
      text-transform: uppercase;
    }

    .about-panel-item span {
      display: block;
      margin-top: 4px;
      color: #0f172a;
      font-size: 14px;
      font-weight: 700;
      line-height: 1.6;
    }

    .about-hero-card-scan {
      bottom: 82px;
      left: 0;
      width: 42%;
      height: 212px;
      background: #020617;
    }

    .about-hero-card-scan::after,
    .about-hero-card-deck::after {
