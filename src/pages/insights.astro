---
import SiteLayout from "../layouts/SiteLayout.astro";
import blogArchive from "../data/novoreperio-blog.json";
import { ExternalLink } from "lucide";

const renderLucideIcon = (iconNode) => {
  const body = iconNode
    .map(([tag, attrs]) => {
      const attrString = Object.entries(attrs)
        .map(([key, value]) => `${key}="${String(value)}"`)
        .join(" ");
      return `<${tag} ${attrString}></${tag}>`;
    })
    .join("");

  return `<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">${body}</svg>`;
};

const posts = blogArchive.posts ?? [];

const stripHtml = (value) => value.replace(/<[^>]+>/g, " ").replace(/\s+/g, " ").trim();

const formatDate = (dateValue) =>
  new Intl.DateTimeFormat("en-MY", {
    day: "numeric",
    month: "long",
    year: "numeric",
  }).format(new Date(dateValue));

const syncedAtLabel = blogArchive.syncedAt ? formatDate(blogArchive.syncedAt) : "Not synced yet";

const topicChips = [
  {
    label: "Spatial presentation",
    icon: "▦",
  },
  {
    label: "Project perspectives",
    icon: "◇",
  },
  {
    label: "Digital twins",
    icon: "▱",
  },
];

const insightCards = [
  {
    label: "Latest notes",
    title: `Browse ${posts.length} imported posts from Novo Reperio's archive.`,
    icon: "▤",
    href: "#latest",
  },
  {
    label: "Virtual tours",
    title: "Immersive views that bring places to life.",
    icon: "⌘",
    href: "/works",
  },
];

const latestPost = posts[0];
const archivePageSize = 4;

const archivePosts = posts.map((post, index) => {
  const category = post.categories?.[0] ?? "";
  const categoryColor = index % 2 === 0 ? "blue" : "pink";

  return {
    ...post,
    category,
    categoryColor,
    title: stripHtml(post.titleHtml),
    excerpt: stripHtml(post.excerptHtml),
    dateLabel: formatDate(post.date),
    page: Math.floor(index / archivePageSize) + 1,
    image:
      post.featuredImage ||
      "https://images.unsplash.com/photo-1486406146926-c627a92ad1ab?auto=format&fit=crop&w=1200&q=80",
  };
});

const archiveTotalPages = Math.max(1, Math.ceil(archivePosts.length / archivePageSize));

const featuredInsight = latestPost
  ? {
      label: "Featured from archive",
      title: stripHtml(latestPost.titleHtml),
      description:
        stripHtml(latestPost.excerptHtml) ||
        "Great decisions start with clarity. Explore how spatial understanding builds confidence, reduces risk, and creates better experiences.",
      image:
        latestPost.featuredImage ||
        "https://images.unsplash.com/photo-1600607687939-ce8a6c25118c?auto=format&fit=crop&w=1200&q=80",
      href: latestPost.link,
      external: true,
    }
  : {
      label: "Spatial Presentation",
      title: "Why spaces need to be understood before they are visited",
      description:
        "Great decisions start with clarity. Explore how spatial understanding builds confidence, reduces risk, and creates better experiences.",
      image:
        "https://images.unsplash.com/photo-1600607687939-ce8a6c25118c?auto=format&fit=crop&w=1200&q=80",
      href: "#featured",
      external: false,
    };
---

<SiteLayout
  title="Novo Reperio Insights | Imported blog archive"
  description="Imported Novo Reperio blog archive built from WordPress post data and rendered inside the new Astro site."
>
  <section class="min-h-screen bg-[#f4f7fb] text-[#07101d]">
    <header class="sticky top-0 z-50 border-b border-white/10 bg-[#070c14]/92 text-white backdrop-blur-xl">
      <div class="mx-auto flex max-w-7xl items-center justify-between px-6 py-4 md:px-10 lg:px-16">
        <a href="/" class="flex items-center gap-3" aria-label="Novo Reperio home">
          <img
            src="/images/Novo-logo-for-website.png.webp"
            alt="Novo Reperio"
            class="h-10 w-auto object-contain"
          />
        </a>

        <nav class="hidden items-center gap-8 text-sm font-semibold text-white/70 lg:flex">
          <a href="/" class="transition hover:text-white">Home</a>
          <a href="/services" class="transition hover:text-white">Services</a>
          <a href="/works" class="transition hover:text-white">Works</a>
          <a href="/about" class="transition hover:text-white">About</a>
          <a href="/contact" class="transition hover:text-white">Contact</a>
          <a href="/insights" class="relative text-white">
            Insights
            <span class="absolute -bottom-3 left-1/2 h-[2px] w-8 -translate-x-1/2 rounded-full bg-blue-500"></span>
          </a>
        </nav>

        <div class="hidden items-center gap-3 md:flex">
          <a
            href="/works"
            class="rounded-lg border border-white/30 px-5 py-2.5 text-sm font-bold text-white transition hover:bg-white hover:text-[#07101d]"
          >
            See Our Work
          </a>
          <a
            href="/contact"
            class="inline-flex items-center gap-2 rounded-lg bg-blue-600 px-5 py-2.5 text-sm font-bold text-white shadow-[0_12px_30px_rgba(37,99,235,0.28)] transition hover:bg-blue-500"
            style="color:#fff"
          >
            Request Quote
          </a>
        </div>
      </div>
    </header>

    <section class="relative overflow-hidden bg-[#050b14] text-white">
      <div class="absolute inset-0">
        <div class="absolute inset-0 bg-[radial-gradient(circle_at_12%_0%,rgba(14,165,233,0.26),transparent_34%),radial-gradient(circle_at_88%_0%,rgba(236,72,153,0.22),transparent_34%),linear-gradient(180deg,#07101d_0%,#050b14_100%)]"></div>
        <div class="absolute inset-0 bg-[linear-gradient(90deg,rgba(5,11,20,0.96)_0%,rgba(5,11,20,0.84)_48%,rgba(5,11,20,0.94)_100%)]"></div>
      </div>

      <div class="relative mx-auto grid max-w-7xl gap-16 px-6 py-20 md:px-10 lg:grid-cols-[0.95fr_1fr] lg:items-start lg:px-16 lg:py-24">
        <div>
          <p class="inline-flex rounded-full border border-white/18 bg-white/8 px-5 py-2 text-xs font-black uppercase tracking-[0.22em] text-white shadow-[inset_0_1px_0_rgba(255,255,255,0.12)] backdrop-blur">
            Insights
          </p>

          <h1 class="mt-8 max-w-3xl text-[clamp(48px,6vw,86px)] font-semibold leading-[0.88] tracking-[-0.08em]">
            Spatial thinking for places that need to be understood.
          </h1>

          <p class="mt-8 max-w-2xl text-base leading-8 text-white/70 md:text-lg">
            Notes from Novo Reperio on virtual tours, digital twins, aerial context,
            and spatial presentation — written to help venues, properties, and
            commercial spaces communicate more clearly.
          </p>

          <div class="mt-9 flex flex-col gap-4 sm:flex-row">
            <a
              href="#latest"
              class="inline-flex items-center justify-center gap-3 rounded-xl bg-blue-600 px-8 py-4 text-sm font-bold text-white shadow-[0_18px_45px_rgba(37,99,235,0.34)] transition hover:-translate-y-0.5 hover:bg-blue-500"
              style="color:#fff"
            >
              Browse Insights
              <span>→</span>
            </a>

            <a
              href="/works"
              class="inline-flex items-center justify-center gap-3 rounded-xl border border-white/20 bg-white/5 px-8 py-4 text-sm font-bold text-white backdrop-blur transition hover:border-white/45 hover:bg-white/10"
            >
              View Selected Work
              <span>→</span>
            </a>
          </div>

          <div class="mt-10 flex flex-wrap gap-3">
            {
              topicChips.map((chip) => (
                <a
                  href="#topics"
                  class="inline-flex items-center gap-3 rounded-full border border-white/14 bg-white/[0.045] px-5 py-3 text-sm font-bold text-white/86 shadow-[inset_0_1px_0_rgba(255,255,255,0.08)] backdrop-blur transition hover:border-blue-400/60 hover:bg-white/[0.07]"
                >
                  <span class="flex h-7 w-7 items-center justify-center rounded-full border border-white/15 bg-white/5 text-blue-300">
                    {chip.icon}
                  </span>
                  {chip.label}
                </a>
              ))
            }
          </div>
        </div>

        <div class="space-y-6">
          <article class="group overflow-hidden rounded-[2rem] border border-white/16 bg-white/[0.045] shadow-[0_32px_100px_rgba(0,0,0,0.32)] backdrop-blur-xl transition hover:-translate-y-1 hover:border-blue-400/40">
            <a
              href={featuredInsight.href}
              class="block"
              target={featuredInsight.external ? "_blank" : undefined}
              rel={featuredInsight.external ? "noreferrer" : undefined}
            >
              <div class="relative h-[320px] overflow-hidden bg-slate-900 md:h-[380px]">
                <img
                  src={featuredInsight.image}
                  alt={featuredInsight.title}
                  class="h-full w-full object-cover opacity-70 transition duration-700 group-hover:scale-105"
                />
                <div class="absolute inset-0 bg-gradient-to-t from-[#050b14] via-[#050b14]/25 to-transparent"></div>

                <span class="absolute left-7 top-7 rounded-full border border-pink-300/25 bg-pink-500/20 px-5 py-2 text-xs font-black uppercase tracking-[0.22em] text-pink-100 backdrop-blur">
                  Featured
                </span>
              </div>

              <div class="p-7 md:p-9">
                <p class="text-xs font-black uppercase tracking-[0.22em] text-pink-300">
                  {featuredInsight.label}
                </p>

                <h2 class="mt-4 max-w-2xl text-3xl font-semibold leading-[1.02] tracking-[-0.06em] text-white md:text-4xl">
                  {featuredInsight.title}
                </h2>

                <p class="mt-5 max-w-2xl text-base leading-8 text-white/66">
                  {featuredInsight.description}
                </p>

                <div class="mt-7 inline-flex items-center gap-3 text-sm font-bold text-blue-400 transition group-hover:gap-4">
                  Read featured insight
                  <span>→</span>
                </div>
              </div>
            </a>
          </article>

          <div class="grid gap-4 sm:grid-cols-2">
            {
              insightCards.map((card) => (
                <a
                  href={card.href}
                  class="group grid grid-cols-[52px_1fr_20px] items-center gap-4 rounded-2xl border border-white/14 bg-white/[0.045] p-5 shadow-[inset_0_1px_0_rgba(255,255,255,0.06)] backdrop-blur transition hover:-translate-y-0.5 hover:border-blue-400/50 hover:bg-white/[0.07]"
                >
                  <div class="flex h-12 w-12 items-center justify-center rounded-full bg-white/8 text-xl text-white/85">
                    {card.icon}
                  </div>

                  <div>
                    <p class="text-[10px] font-black uppercase tracking-[0.2em] text-white/50">
                      {card.label}
                    </p>
                    <p class="mt-1 text-sm font-semibold leading-6 text-white">
                      {card.title}
                    </p>
                  </div>

                  <span class="text-xl text-white/55 transition group-hover:translate-x-1 group-hover:text-blue-300">
                    →
                  </span>
                </a>
              ))
            }
          </div>
        </div>
      </div>
    </section>

    <section id="latest" class="bg-[#f5f7fb] px-6 py-20 text-[#07101d] md:px-10 lg:px-16">
      <div class="mx-auto max-w-7xl">
        <div class="max-w-4xl">
          <p class="text-xs font-black uppercase tracking-[0.24em] text-blue-600">
            Insights Archive
          </p>

          <div class="mt-3 h-[2px] w-14 bg-pink-500"></div>

          <h2 class="mt-7 max-w-4xl text-[clamp(34px,4vw,54px)] font-semibold leading-[1.02] tracking-[-0.06em]">
            Spatial insights for clearer project decisions<span class="text-pink-500">.</span>
          </h2>

          <p class="mt-7 max-w-3xl text-base leading-8 text-slate-600 md:text-lg">
            Explore practical articles on digital twins, virtual tours, LiDAR scanning,
            Scan to BIM, and spatial presentation — designed to help you plan, manage,
            and showcase properties, venues, and facilities with confidence.
          </p>
        </div>

        {archivePosts.length > 0 ? (
          <>
            <div id="archive-grid" class="mt-8 grid gap-6 lg:grid-cols-2">
            {archivePosts.map((post) => (
              <article
                data-archive-card
                data-archive-page={post.page}
                class={`group overflow-hidden rounded-[1.75rem] border border-slate-200 bg-white shadow-[0_24px_80px_rgba(15,23,42,0.08)] transition duration-300 hover:-translate-y-1 hover:shadow-[0_34px_100px_rgba(15,23,42,0.13)] ${post.page === 1 ? "" : "hidden"}`}
              >
                <a href={post.link} class="block" target="_blank" rel="noreferrer">
                  <div class="relative aspect-[16/7] overflow-hidden bg-slate-200">
                    <img
                      src={post.image}
                      alt={post.featuredImageAlt || post.title}
                      class="h-full w-full object-cover transition duration-700 group-hover:scale-105"
                      loading="lazy"
                    />

                    <div class="absolute inset-0 bg-gradient-to-t from-black/10 via-transparent to-transparent"></div>

                    <div class="absolute left-5 top-5 hidden rounded-2xl border border-white/30 bg-slate-950/55 p-4 text-white shadow-[0_16px_50px_rgba(15,23,42,0.25)] backdrop-blur md:block">
                      <div class="h-2 w-28 rounded-full bg-white/30"></div>
                      <div class="mt-3 h-2 w-20 rounded-full bg-blue-300/70"></div>
                      <div class="mt-4 grid grid-cols-3 gap-2">
                        <div class="h-8 rounded-lg bg-white/15"></div>
                        <div class="h-8 rounded-lg bg-white/15"></div>
                        <div class="h-8 rounded-lg bg-white/15"></div>
                      </div>
                    </div>
                  </div>

                  <div class="p-6 md:p-8">
                    <h3 class="text-2xl font-semibold leading-[1.05] tracking-[-0.055em] md:text-3xl">
                      {post.title}
                    </h3>

                    <p class="mt-4 max-w-2xl text-sm leading-7 text-slate-600 md:text-base">
                      {post.excerpt}
                    </p>

                    <div class="mt-7 flex flex-col gap-4 border-t border-slate-200 pt-5 sm:flex-row sm:items-center sm:justify-between">
                      <div class="flex flex-wrap items-center gap-x-5 gap-y-2 text-sm text-slate-500">
                        <span class="inline-flex items-center gap-2">
                          <span class="text-blue-600">▣</span>
                          {post.dateLabel}
                        </span>

                        <span class="inline-flex items-center gap-2">
                          <span class="text-blue-600">◌</span>
                          By {post.author}
                        </span>
                      </div>

                      <span class="inline-flex items-center gap-3 text-sm font-bold text-blue-600 transition group-hover:gap-4">
                        Read insight
                        <span>→</span>
                      </span>
                    </div>
                  </div>
                </a>
              </article>
            ))}
            </div>

            <div class="mt-10 flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between">
              <p id="archive-pagination-status" class="text-sm font-medium text-slate-500">
                Page 1 of {archiveTotalPages}
              </p>

              <div class="flex items-center gap-3">
                <button
                  id="archive-prev"
                  type="button"
                  class="inline-flex min-h-11 items-center justify-center rounded-xl border border-slate-300 bg-white px-5 text-sm font-bold text-slate-800 transition hover:border-blue-400 hover:text-blue-700 disabled:cursor-not-allowed disabled:opacity-45"
                  disabled
                >
                  Prev
                </button>
                <button
                  id="archive-next"
                  type="button"
                  class="inline-flex min-h-11 items-center justify-center rounded-xl bg-blue-600 px-5 text-sm font-bold text-white shadow-[0_12px_34px_rgba(37,99,235,0.22)] transition hover:bg-blue-500 disabled:cursor-not-allowed disabled:opacity-45"
                  disabled={archiveTotalPages <= 1}
                >
                  Next
                </button>
              </div>
            </div>
          </>
        ) : (
          <div class="mt-10 rounded-[28px] border border-dashed border-slate-300 bg-white p-8 text-slate-600">
            <p class="text-lg font-bold text-[#07101d]">No blog posts synced yet.</p>
            <p class="mt-3 max-w-2xl text-sm leading-7">
              Run <code>npm run sync:blog</code> to pull posts from existing WordPress blog into
              <code>src/data/novoreperio-blog.json</code>, then rebuild site.
            </p>
          </div>
        )}
      </div>
    </section>

    <footer class="bg-[#07101d] px-6 py-12 text-white md:px-10 lg:px-16">
      <div class="mx-auto max-w-7xl">
        <div class="grid gap-10 border-b border-white/10 pb-10 lg:grid-cols-[1.5fr_3fr]">
          <div>
            <h2 class="text-2xl font-semibold tracking-[-0.05em]">
              Ready to talk about your space?
            </h2>
            <p class="mt-3 max-w-md text-sm leading-7 text-white/58">
              Share a few details and we&apos;ll get back with right next step.
            </p>

            <form class="mt-6 flex max-w-md flex-col gap-3 sm:flex-row">
              <label class="sr-only" for="insights-footer-email">Your email address</label>
              <input
                id="insights-footer-email"
                type="email"
                placeholder="Your email address"
                class="min-h-12 flex-1 rounded-lg border border-white/15 bg-white/5 px-4 text-sm text-white outline-none placeholder:text-white/35 focus:border-blue-400"
              />
              <button
                type="submit"
                class="min-h-12 rounded-lg bg-blue-600 px-6 text-sm font-bold text-white transition hover:bg-blue-500"
              >
                Request Quote
              </button>
            </form>
          </div>

          <div class="grid gap-8 sm:grid-cols-2 lg:grid-cols-4">
            <div>
              <h3 class="text-xs font-black uppercase tracking-[0.18em] text-white/60">Insights</h3>
              <ul class="mt-4 space-y-3">
                <li><a href="#latest" class="text-sm text-white/58 transition hover:text-white">Latest Posts</a></li>
                <li><a href={blogArchive.source} target="_blank" rel="noreferrer" class="text-sm text-white/58 transition hover:text-white">Original Blog</a></li>
                <li><a href={latestPost?.link ?? "#"} target={latestPost ? "_blank" : undefined} rel={latestPost ? "noreferrer" : undefined} class="text-sm text-white/58 transition hover:text-white">Featured Insight</a></li>
              </ul>
            </div>
            <div>
              <h3 class="text-xs font-black uppercase tracking-[0.18em] text-white/60">Services</h3>
              <ul class="mt-4 space-y-3">
                <li><a href="/services#matterport" class="text-sm text-white/58 transition hover:text-white">Matterport 3D Virtual Tours</a></li>
                <li><a href="/services#tours-360" class="text-sm text-white/58 transition hover:text-white">360 Virtual Tours</a></li>
                <li><a href="/services#drone-aerial" class="text-sm text-white/58 transition hover:text-white">Drone & Aerial</a></li>
                <li><a href="/services#support-services" class="text-sm text-white/58 transition hover:text-white">Support Services</a></li>
              </ul>
            </div>
            <div>
              <h3 class="text-xs font-black uppercase tracking-[0.18em] text-white/60">Company</h3>
              <ul class="mt-4 space-y-3">
                <li><a href="/about" class="text-sm text-white/58 transition hover:text-white">About Novo Reperio</a></li>
                <li><a href="/works" class="text-sm text-white/58 transition hover:text-white">Works</a></li>
                <li><a href="/insights" class="text-sm text-white/58 transition hover:text-white">Insights</a></li>
                <li><a href="/contact" class="text-sm text-white/58 transition hover:text-white">Contact</a></li>
              </ul>
            </div>
            <div>
              <h3 class="text-xs font-black uppercase tracking-[0.18em] text-white/60">Next</h3>
              <ul class="mt-4 space-y-3">
                <li><a href="/works" class="text-sm text-white/58 transition hover:text-white">See Our Work</a></li>
                <li><a href="/contact" class="text-sm text-white/58 transition hover:text-white">Start Brief</a></li>
                <li><a href="/" class="text-sm text-white/58 transition hover:text-white">Back to homepage</a></li>
              </ul>
            </div>
          </div>
        </div>

        <div class="flex flex-col gap-6 pt-8 md:flex-row md:items-center md:justify-between">
          <a href="/" class="flex items-center gap-3" aria-label="Novo Reperio home">
            <img
              src="/images/Novo-logo-for-website.png.webp"
              alt="Novo Reperio"
              class="h-10 w-auto object-contain"
              loading="lazy"
            />
          </a>

          <div class="flex flex-wrap gap-5 text-sm text-white/45">
            <a href="#" class="transition hover:text-white">Privacy Policy</a>
            <a href="#" class="transition hover:text-white">Terms</a>
            <a href="/contact" class="transition hover:text-white">Contact</a>
          </div>

          <p class="text-sm text-white/35">Virtual tours and spatial presentation for venues, property, hospitality, and retail.</p>
        </div>
      </div>
    </footer>

    <script define:vars={{ archiveTotalPages }}>
      const archiveCards = Array.from(document.querySelectorAll("[data-archive-card]"));
      const prevButton = document.querySelector("#archive-prev");
      const nextButton = document.querySelector("#archive-next");
      const status = document.querySelector("#archive-pagination-status");
      const totalPages = archiveTotalPages;

      if (archiveCards.length > 0 && prevButton && nextButton && status) {
        let currentPage = 1;

        const renderArchivePage = () => {
          archiveCards.forEach((card) => {
            const cardPage = Number(card.getAttribute("data-archive-page") || "1");
            card.classList.toggle("hidden", cardPage !== currentPage);
          });

          status.textContent = `Page ${currentPage} of ${totalPages}`;
          prevButton.disabled = currentPage === 1;
          nextButton.disabled = currentPage === totalPages;
        };

        prevButton.addEventListener("click", () => {
          if (currentPage === 1) return;
          currentPage -= 1;
          renderArchivePage();
          document.querySelector("#latest")?.scrollIntoView({ behavior: "smooth", block: "start" });
        });

        nextButton.addEventListener("click", () => {
          if (currentPage === totalPages) return;
          currentPage += 1;
          renderArchivePage();
          document.querySelector("#latest")?.scrollIntoView({ behavior: "smooth", block: "start" });
        });

        renderArchivePage();
      }
    </script>
  </section>
</SiteLayout>
