---
import SiteLayout from "../layouts/SiteLayout.astro";
import {
  ArrowRight,
  Building2,
  CalendarRange,
  Check,
  FileImage,
  Mail,
  MapPin,
  MessageCircle,
  Workflow,
} from "lucide";

const renderLucideIcon = (iconNode) => {
  const body = iconNode
    .map(([tag, attrs]) => {
      const attrString = Object.entries(attrs)
        .map(([key, value]) => `${key}="${String(value)}"`)
        .join(" ");
      return `<${tag} ${attrString}></${tag}>`;
    })
    .join("");

  return `<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">${body}</svg>`;
};

const contactCards = [
  {
    label: "Email",
    title: "hello@novoreperio.com",
    description: "Best for briefs, timelines, decks, links, and detailed context.",
    href: "mailto:hello@novoreperio.com",
    icon: Mail,
  },
  {
    label: "WhatsApp",
    title: "+60 17-202 9996",
    description: "Best for quick first contact when you already know the project or venue.",
    href: "https://wa.me/60172029996",
    icon: MessageCircle,
  },
  {
    label: "Studio Base",
    title: "Solaris Mont Kiara, 50480 Kuala Lumpur, Malaysia",
    description: "Useful when local context, site planning, or in-person coordination matters.",
    href: "https://maps.google.com/?q=Solaris+Mont+Kiara+50480+Kuala+Lumpur+Malaysia",
    icon: MapPin,
  },
];

const approachSteps = [
  {
    number: "01",
    title: "Start with the space",
    description:
      "Say whether this is a venue, ballroom, hotel, property, museum, retail environment, showroom, office, or another physical space.",
    icon: Building2,
  },
  {
    number: "02",
    title: "Explain the decision",
    description:
      "Describe what the digital experience needs to help someone do: enquire, shortlist, approve, plan, review, or book.",
    icon: Workflow,
  },
  {
    number: "03",
    title: "Share the timing",
    description:
      "Include any launch date, event window, or internal deadline so the reply can be framed around the real urgency.",
    icon: CalendarRange,
  },
  {
    number: "04",
    title: "Add references if you have them",
    description:
      "Floor plans, website links, stills, or example projects help narrow the right capture format quickly.",
    icon: FileImage,
  },
];

const includeItems = [
  "Project type",
  "Location",
  "What output you think you need, if known",
  "What the client or stakeholder needs to understand",
  "Timeline or preferred capture window",
];

const sampleImages = [
  {
    src: "https://images.unsplash.com/photo-1600607687939-ce8a6c25118c?auto=format&fit=crop&w=500&q=80",
    alt: "Premium interior space",
  },
  {
    src: "https://images.unsplash.com/photo-1497366754035-f200968a6e72?auto=format&fit=crop&w=500&q=80",
    alt: "Commercial interior",
  },
  {
    src: "https://images.unsplash.com/photo-1486406146926-c627a92ad1ab?auto=format&fit=crop&w=500&q=80",
    alt: "Modern building exterior",
  },
  {
    src: "https://images.unsplash.com/photo-1600585154340-be6161a56a0c?auto=format&fit=crop&w=500&q=80",
    alt: "Modern property interior",
  },
];

const footerColumns = [
  {
    title: "Contact",
    links: [
      { label: "Email Novo", href: "mailto:hello@novoreperio.com" },
      { label: "WhatsApp", href: "https://wa.me/60172029996" },
      {
        label: "Studio Base",
        href: "https://maps.google.com/?q=Solaris+Mont+Kiara+50480+Kuala+Lumpur+Malaysia",
      },
    ],
  },
  {
    title: "Services",
    links: [
      { label: "Matterport 3D Virtual Tours", href: "/services#matterport" },
      { label: "360 Virtual Tours", href: "/services#tours-360" },
      { label: "Drone & Aerial", href: "/services#drone-aerial" },
      { label: "Support Services", href: "/services#support-services" },
    ],
  },
  {
    title: "Company",
    links: [
      { label: "About Novo Reperio", href: "/about" },
      { label: "Works", href: "/works" },
      { label: "Insights", href: "/insights" },
      { label: "Contact", href: "/contact" },
    ],
  },
  {
    title: "Next",
    links: [
      { label: "See project examples", href: "/works" },
      { label: "Start a brief", href: "mailto:hello@novoreperio.com" },
      { label: "Back to homepage", href: "/" },
    ],
  },
];
---

<SiteLayout
  title="Contact Novo Reperio | Start your brief"
  description="Contact Novo Reperio with project context, timing, and references so the team can recommend the right digital experience for your space."
>
  <section class="min-h-screen bg-[#f6f8fb] text-[#07101d]">
    <header class="border-b border-white/10 bg-[#070c14] text-white">
      <div class="mx-auto flex max-w-7xl items-center justify-between px-6 py-4 md:px-10 lg:px-16">
        <a href="/" class="flex items-center gap-3" aria-label="Novo Reperio home">
          <div class="flex h-8 w-8 items-center justify-center rounded-full bg-gradient-to-br from-pink-500 via-orange-400 to-blue-500 text-xs font-black">
            N
          </div>
          <span class="text-xl font-semibold tracking-[-0.04em]">NOVO</span>
        </a>

        <nav class="hidden items-center gap-8 text-sm font-semibold text-white/70 lg:flex">
          <a href="/" class="transition hover:text-white">Home</a>
          <a href="/services" class="transition hover:text-white">Services</a>
          <a href="/works" class="transition hover:text-white">Works</a>
          <a href="/about" class="transition hover:text-white">About</a>
          <a href="/contact" class="relative text-white">
            Contact
            <span class="absolute -bottom-3 left-1/2 h-[2px] w-8 -translate-x-1/2 rounded-full bg-blue-500"></span>
          </a>
          <a href="/insights" class="transition hover:text-white">Insights</a>
        </nav>

        <div class="hidden items-center gap-3 md:flex">
          <a
            href="/about"
            class="rounded-lg border border-white/30 px-5 py-2.5 text-sm font-bold text-white transition hover:bg-white hover:text-[#07101d]"
          >
            About Novo
          </a>
          <a
            href="mailto:hello@novoreperio.com"
            class="inline-flex items-center gap-2 rounded-lg bg-blue-600 px-5 py-2.5 text-sm font-bold text-white shadow-[0_12px_30px_rgba(37,99,235,0.28)] transition hover:bg-blue-500"
          >
            <span class="h-4 w-4" set:html={renderLucideIcon(Mail)} />
            Email Novo
          </a>
        </div>
      </div>
    </header>

    <section class="relative overflow-hidden bg-[#07101d] text-white">
      <div class="absolute inset-0">
        <img
          src="https://images.unsplash.com/photo-1486406146926-c627a92ad1ab?auto=format&fit=crop&w=1800&q=80"
          alt=""
          class="h-full w-full object-cover opacity-[0.16]"
        />
        <div class="absolute inset-0 bg-[linear-gradient(90deg,#07101d_0%,rgba(7,16,29,0.92)_35%,rgba(7,16,29,0.82)_100%)]"></div>
        <div class="absolute inset-0 bg-[radial-gradient(circle_at_78%_12%,rgba(14,165,233,0.22),transparent_34%)]"></div>
      </div>

      <div class="relative mx-auto grid max-w-7xl gap-12 px-6 py-20 md:px-10 lg:grid-cols-[0.9fr_1fr] lg:px-16 lg:py-24">
        <div class="flex flex-col justify-center">
          <p class="mb-6 text-xs font-black uppercase tracking-[0.22em] text-pink-500">
            Contact
          </p>

          <h1 class="max-w-2xl text-[clamp(3.4rem,6vw,6.9rem)] font-semibold leading-[0.9] tracking-[-0.08em]">
            Tell us about your space, not just the deliverable.
          </h1>

          <p class="mt-7 max-w-xl text-base leading-8 text-white/72 md:text-lg">
            The most useful first enquiry shares the space, audience, and decision
            context so we can recommend the right approach from the start.
          </p>

          <div class="mt-8 flex flex-col gap-4 sm:flex-row">
            <a
              href="mailto:hello@novoreperio.com"
              class="inline-flex items-center justify-center gap-3 rounded-lg bg-blue-600 px-7 py-4 text-sm font-bold text-white shadow-[0_16px_40px_rgba(37,99,235,0.32)] transition hover:-translate-y-0.5 hover:bg-blue-500"
            >
              <span class="h-5 w-5" set:html={renderLucideIcon(Mail)} />
              Send Project Details
            </a>

            <a
              href="https://wa.me/60172029996"
              class="inline-flex items-center justify-center gap-3 rounded-lg border border-white/30 bg-white/5 px-7 py-4 text-sm font-bold text-white backdrop-blur transition hover:border-white/70 hover:bg-white/10"
            >
              <span class="h-5 w-5" set:html={renderLucideIcon(MessageCircle)} />
              Start on WhatsApp
            </a>
          </div>
        </div>

        <div class="space-y-4 lg:pl-10">
          {contactCards.map((card) => (
            <a
              href={card.href}
              class="group grid grid-cols-[64px_1fr_20px] items-center gap-5 rounded-2xl border border-white/16 bg-white/[0.045] p-6 shadow-[0_24px_70px_rgba(0,0,0,0.22)] backdrop-blur-xl transition hover:-translate-y-0.5 hover:border-blue-400/70 hover:bg-white/[0.07]"
            >
              <div class="flex h-14 w-14 items-center justify-center rounded-full border border-white/18 bg-white/5 text-blue-300">
                <span class="h-6 w-6" set:html={renderLucideIcon(card.icon)} />
              </div>

              <div>
                <p class="text-[10px] font-black uppercase tracking-[0.2em] text-white/45">
                  {card.label}
                </p>
                <h2 class="mt-2 text-xl font-semibold leading-tight tracking-[-0.03em] text-white md:text-2xl">
                  {card.title}
                </h2>
                <p class="mt-2 max-w-lg text-sm leading-6 text-white/58">
                  {card.description}
                </p>
              </div>

              <span class="h-5 w-5 text-white/55 transition group-hover:translate-x-1 group-hover:text-blue-300" set:html={renderLucideIcon(ArrowRight)} />
            </a>
          ))}
        </div>
      </div>
    </section>

    <section class="px-6 py-16 md:px-10 lg:px-16">
      <div class="mx-auto grid max-w-6xl gap-5 lg:grid-cols-[1.05fr_0.95fr]">
        <article class="rounded-3xl border border-slate-200 bg-white p-6 shadow-[0_24px_80px_rgba(15,23,42,0.08)] md:p-8">
          <p class="text-xs font-black uppercase tracking-[0.22em] text-blue-600">
            How to approach us
          </p>
          <h2 class="mt-4 text-3xl font-semibold tracking-[-0.06em] md:text-4xl">
            Start with the project context.
          </h2>
          <p class="mt-3 max-w-2xl text-sm leading-7 text-slate-600">
            Novo works at the intersection of space, presentation, and commercial
            clarity. A short, context-rich brief is more useful than asking only
            for a price.
          </p>

          <div class="relative mt-8 space-y-4">
            <div class="absolute bottom-8 left-[22px] top-8 hidden w-px bg-blue-200 sm:block"></div>

            {approachSteps.map((step) => (
              <div class="relative grid gap-4 sm:grid-cols-[48px_1fr]">
                <div class="relative z-10 flex h-11 w-11 items-center justify-center rounded-full border border-blue-500 bg-white text-sm font-black text-blue-700">
                  {step.number}
                </div>

                <div class="grid gap-4 rounded-2xl border border-slate-200 bg-white p-5 shadow-[0_10px_34px_rgba(15,23,42,0.06)] sm:grid-cols-[44px_1fr]">
                  <div class="flex h-11 w-11 items-center justify-center rounded-xl bg-blue-50 text-blue-700">
                    <span class="h-5 w-5" set:html={renderLucideIcon(step.icon)} />
                  </div>

                  <div>
                    <h3 class="text-lg font-bold tracking-[-0.03em] text-blue-700">
                      {step.title}
                    </h3>
                    <p class="mt-1 text-sm leading-6 text-slate-600">
                      {step.description}
                    </p>
                  </div>
                </div>
              </div>
            ))}
          </div>
        </article>

        <div class="space-y-5">
          <article class="rounded-3xl border border-slate-200 bg-white p-6 shadow-[0_24px_80px_rgba(15,23,42,0.08)] md:p-8">
            <p class="text-xs font-black uppercase tracking-[0.22em] text-pink-500">
              What to include
            </p>
            <h2 class="mt-4 text-3xl font-semibold tracking-[-0.06em] md:text-4xl">
              What to include.
            </h2>
            <p class="mt-3 max-w-2xl text-sm leading-7 text-slate-600">
              These points help us give a more specific reply in the first email
              or WhatsApp message.
            </p>

            <ul class="mt-6 grid gap-3 sm:grid-cols-2">
              {includeItems.map((item) => (
                <li class="flex items-start gap-3 text-sm leading-6 text-slate-700">
                  <span class="mt-1 flex h-5 w-5 shrink-0 items-center justify-center rounded-full bg-blue-600 text-white">
                    <span class="h-3 w-3" set:html={renderLucideIcon(Check)} />
                  </span>
                  <span>{item}</span>
                </li>
              ))}
            </ul>
          </article>

          <article class="rounded-3xl border border-slate-200 bg-white p-6 shadow-[0_24px_80px_rgba(15,23,42,0.08)] md:p-8">
            <p class="text-xs font-black uppercase tracking-[0.22em] text-pink-500">
              Need examples first?
            </p>
            <h2 class="mt-4 text-3xl font-semibold leading-none tracking-[-0.06em] md:text-4xl">
              See how we&apos;ve helped other spaces.
            </h2>
            <p class="mt-3 max-w-xl text-sm leading-7 text-slate-600">
              Explore spatial projects and case studies to understand the
              approach, outputs, and results we deliver.
            </p>

            <div class="mt-6 flex flex-col gap-3 sm:flex-row">
              <a
                href="/works"
                class="inline-flex items-center justify-center rounded-lg bg-blue-600 px-6 py-3 text-sm font-bold text-white transition hover:bg-blue-700"
              >
                See Our Work
              </a>
              <a
                href="/about"
                class="inline-flex items-center justify-center rounded-lg border border-blue-600 px-6 py-3 text-sm font-bold text-blue-700 transition hover:bg-blue-50"
              >
                Read About Novo
              </a>
            </div>

            <div class="mt-6 grid grid-cols-2 gap-3 sm:grid-cols-4">
              {sampleImages.map((image) => (
                <div class="aspect-[4/3] overflow-hidden rounded-xl bg-slate-200">
                  <img
                    src={image.src}
                    alt={image.alt}
                    class="h-full w-full object-cover transition duration-700 hover:scale-105"
                    loading="lazy"
                  />
                </div>
              ))}
            </div>
          </article>
        </div>
      </div>
    </section>

    <footer class="bg-[#07101d] px-6 py-12 text-white md:px-10 lg:px-16">
      <div class="mx-auto max-w-7xl">
        <div class="grid gap-10 border-b border-white/10 pb-10 lg:grid-cols-[1.5fr_3fr]">
          <div>
            <h2 class="text-2xl font-semibold tracking-[-0.05em]">
              Ready to talk about your space?
            </h2>
            <p class="mt-3 max-w-md text-sm leading-7 text-white/58">
              Share a few details and we&apos;ll get back with the right next step.
            </p>

            <form class="mt-6 flex max-w-md flex-col gap-3 sm:flex-row">
              <label class="sr-only" for="footer-email">Your email address</label>
              <input
                id="footer-email"
                type="email"
                placeholder="Your email address"
                class="min-h-12 flex-1 rounded-lg border border-white/15 bg-white/5 px-4 text-sm text-white outline-none placeholder:text-white/35 focus:border-blue-400"
              />
              <button
                type="submit"
                class="min-h-12 rounded-lg bg-blue-600 px-6 text-sm font-bold text-white transition hover:bg-blue-500"
              >
                Request Quote
              </button>
            </form>
          </div>

          <div class="grid gap-8 sm:grid-cols-2 lg:grid-cols-4">
            {footerColumns.map((column) => (
              <div>
                <h3 class="text-xs font-black uppercase tracking-[0.18em] text-white/60">
                  {column.title}
                </h3>
                <ul class="mt-4 space-y-3">
                  {column.links.map((link) => (
                    <li>
                      <a href={link.href} class="text-sm text-white/58 transition hover:text-white">
                        {link.label}
                      </a>
                    </li>
                  ))}
                </ul>
              </div>
            ))}
          </div>
        </div>

        <div class="flex flex-col gap-6 pt-8 md:flex-row md:items-center md:justify-between">
          <a href="/" class="flex items-center gap-3" aria-label="Novo Reperio home">
            <div class="flex h-8 w-8 items-center justify-center rounded-full bg-gradient-to-br from-pink-500 via-orange-400 to-blue-500 text-xs font-black">
              N
            </div>
            <span class="text-xl font-semibold tracking-[-0.04em]">NOVO</span>
          </a>

          <div class="flex flex-wrap gap-5 text-sm text-white/45">
            <a href="#" class="transition hover:text-white">Privacy Policy</a>
            <a href="#" class="transition hover:text-white">Terms</a>
            <a href="/contact" class="transition hover:text-white">Contact</a>
          </div>

          <p class="text-sm text-white/35">Novo Reperio contact page.</p>
        </div>
      </div>
    </footer>
  </section>
</SiteLayout>
