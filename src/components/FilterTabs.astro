---
interface Props {
  filters: string[];
  group: string;
  label: string;
  allLabel: string;
}

const { filters, group, label, allLabel } = Astro.props;
---

<div class="filter-group">
  <div class="filter-group-label">{label}</div>
  <div class="filter-tabs flex gap-3 overflow-x-auto pb-1 md:flex-wrap md:overflow-visible" aria-label={`${label} filters`}>
    {[allLabel, ...filters].map((filter, index) => (
      <button
        type="button"
        class={`filter-tab inline-flex min-h-11 shrink-0 items-center gap-2 rounded-[10px] border border-black/6 bg-zinc-50 px-4 py-2 text-[11px] font-black uppercase tracking-[0.08em] text-zinc-700 transition ${index === 0 ? "is-active" : ""}`}
        data-filter-button
        data-filter-group={group}
        data-filter={filter}
        aria-pressed={index === 0 ? "true" : "false"}
      >
        <span>{filter}</span>
      </button>
    ))}
  </div>
</div>

<style>
  .filter-group {
    display: grid;
    gap: 12px;
  }

  .filter-group-label {
    color: #6b7280;
    font-size: 10px;
    font-weight: 900;
    letter-spacing: 0.18em;
    text-transform: uppercase;
  }

  .filter-tabs::-webkit-scrollbar {
    height: 0;
  }

  .filter-tab {
    box-shadow: 0 10px 18px rgba(16,17,20,.04);
  }

  .filter-tab:hover,
  .filter-tab.is-active {
    color: #fff;
    border-color: #3557dc;
    background: #3557dc;
    box-shadow: 0 12px 22px rgba(53,87,220,.18);
  }
</style>
