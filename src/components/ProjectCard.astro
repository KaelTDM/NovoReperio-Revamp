---
import { Image } from "astro:assets";
import { getWorkImageTreatmentClass, resolveWorkImage } from "../lib/workImage";

interface Project {
  id: string;
  title: string;
  serviceType: string;
  cardLabel: string;
  filterGroup: string;
  industry: string;
  spaceType?: string;
  location?: string;
  image?: string;
  imageAlt?: string;
  description: string;
  impact?: string;
  viewUrl: string;
}

interface Props {
  project: Project;
  index: number;
}

const { project, index } = Astro.props;
const locationTag = project.location?.split(",")[0];
const image = resolveWorkImage(project, { width: 1600, height: 900 });
const treatmentClass = getWorkImageTreatmentClass(index);
---

<article
  class="project-card rounded-[16px] border border-black/8 bg-white/95"
  data-project-card
  data-service-filter={project.filterGroup}
  data-space-filter={project.spaceType ?? project.industry}
>
  <a class="group flex h-full flex-col" href={project.viewUrl} target="_blank" rel="noreferrer">
    <div class={`project-card-media aspect-video overflow-hidden rounded-t-[16px] border-b border-black/6 bg-slate-100 ${treatmentClass}`}>
      <Image
        src={image.src}
        alt={image.alt}
        width={1600}
        height={900}
        sizes="(max-width: 820px) 100vw, (max-width: 1180px) 50vw, 33vw"
        class="h-full w-full object-cover transition duration-500 ease-out group-hover:scale-[1.04]"
      />
      <span class="absolute left-3 top-3 rounded-full border border-white/12 bg-zinc-950/78 px-3 py-1 text-[10px] font-black uppercase tracking-[0.16em] text-white backdrop-blur-md">
        {project.cardLabel}
      </span>
      {locationTag && (
        <span class="absolute right-3 top-3 rounded-full border border-white/22 bg-white/92 px-3 py-1 text-[10px] font-black uppercase tracking-[0.16em] text-zinc-900 backdrop-blur-md">
          {locationTag}
        </span>
      )}
      <div class="absolute inset-x-3 bottom-3 translate-y-2 rounded-2xl border border-white/15 bg-sky-500/94 px-4 py-3 text-center text-[11px] font-black uppercase tracking-[0.16em] text-white opacity-0 shadow-[0_16px_32px_rgba(21,159,230,.22)] transition duration-300 group-hover:translate-y-0 group-hover:opacity-100">
        View Project
      </div>
    </div>

    <div class="flex flex-1 flex-col gap-4 p-4 md:p-5">
      <div class="flex flex-wrap gap-2 text-[10px] font-black uppercase tracking-[0.16em] text-zinc-600">
        <span class="rounded-full border border-sky-500/16 bg-sky-50 px-2.5 py-1 text-sky-700">{project.industry}</span>
        {project.spaceType && <span class="rounded-full border border-black/8 bg-white px-2.5 py-1">{project.spaceType}</span>}
        {project.location && <span class="rounded-full border border-black/8 bg-white px-2.5 py-1">{project.location}</span>}
      </div>

      <div class="border-b border-black/8 pb-4">
        <h3 class="text-[1.65rem] font-semibold leading-[0.98] tracking-[-0.06em] text-zinc-950">
          {project.title}
        </h3>
        <p class="mt-3 line-clamp-2 text-sm leading-7 text-zinc-600">
          {project.description}
        </p>
      </div>

      {project.impact && (
        <p class="line-clamp-2 text-sm font-medium leading-7 text-zinc-900">
          <span class="mr-2 inline-block text-[10px] font-black uppercase tracking-[0.16em] text-sky-600">
            Impact
          </span>
          {project.impact}
        </p>
      )}
    </div>
  </a>
</article>

<style>
  .project-card.is-hidden {
    display: none;
  }

  .project-card {
    box-shadow: 0 16px 36px rgba(16, 17, 20, 0.08);
    transition: transform 0.24s ease, box-shadow 0.24s ease, border-color 0.24s ease, background 0.24s ease;
  }

  .project-card:hover {
    transform: translateY(-4px);
    border-color: rgba(21, 159, 230, 0.18);
    box-shadow: 0 22px 42px rgba(16, 17, 20, 0.12);
    background: linear-gradient(180deg, rgba(255,255,255,.99), rgba(247,250,253,.99));
  }

  .project-card-media {
    position: relative;
    isolation: isolate;
  }

  .project-card-media :global(img) {
    filter: saturate(0.98) contrast(1.02);
  }

  .work-image-treatment-0 :global(img) {
    filter: saturate(0.9) contrast(1.04) brightness(0.98);
  }

  .work-image-treatment-1 :global(img) {
    filter: hue-rotate(-6deg) saturate(0.92) brightness(0.99);
  }

  .work-image-treatment-2 :global(img) {
    filter: hue-rotate(7deg) saturate(0.88) brightness(1.02);
  }

  .work-image-treatment-3 :global(img) {
    filter: saturate(0.86) contrast(1.08) brightness(0.97);
  }

  .work-image-treatment-4 :global(img) {
    filter: hue-rotate(12deg) saturate(0.94) contrast(1.03);
  }
  
  @media (max-width: 820px) {
    .project-card-media > div:last-child {
      opacity: 1;
      transform: translateY(0);
    }
  }
</style>
